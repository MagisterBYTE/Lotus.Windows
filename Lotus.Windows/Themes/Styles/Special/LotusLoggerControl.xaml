<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Lotus.Windows">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/LotusResourceStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Конвертер типа лога в иконку  -->
    <ctrl:LogTypeToImageConverter
        x:Key="LotusLogTypeToImageConverterKey"
        Error="/Lotus.Windows;component/Resources/Icons/Status/Oxygen_dialog_error_32.png"
        Failed="/Lotus.Windows;component/Resources/Icons/Status/Oxygen_security_low_32.png"
        Info="/Lotus.Windows;component/Resources/Icons/Status/Oxygen_dialog_information_32.png"
        Succeed="/Lotus.Windows;component/Resources/Icons/Status/Oxygen_security_high_32.png"
        Warning="/Lotus.Windows;component/Resources/Icons/Status/Oxygen_dialog_warning_32.png" />

    <!--  Простое сообщение  -->
    <DataTemplate x:Key="LotusLogSimpleMessageKey">
        <StackPanel Orientation="Horizontal">
            <Image
                Height="24"
                Margin="2,0"
                VerticalAlignment="Center"
                Source="{Binding Path=Type, Converter={StaticResource LotusLogTypeToImageConverterKey}}" />
            <TextBlock
                Margin="8,0"
                VerticalAlignment="Center"
                Text="{Binding Path=Text}" />
        </StackPanel>
    </DataTemplate>

    <!--  Простое сообщение с указанием модуля  -->
    <DataTemplate x:Key="LotusLogSimpleModuleMessageKey">
        <StackPanel Orientation="Horizontal">
            <Image
                Height="24"
                Margin="2,0"
                VerticalAlignment="Center"
                Source="{Binding Path=Type, Converter={StaticResource LotusLogTypeToImageConverterKey}}" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="Bold"
                Text="{Binding Path=Module, StringFormat='[\{0\}]'}" />
            <TextBlock
                Margin="8,0"
                VerticalAlignment="Center"
                Text="{Binding Path=Text}" />
        </StackPanel>
    </DataTemplate>

    <!--  Сообщение с трассировкой  -->
    <DataTemplate x:Key="LotusLogTraceMessageKey">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Image
                    Height="24"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Source="{Binding Path=Type, Converter={StaticResource LotusLogTypeToImageConverterKey}}" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Text}" />
            </StackPanel>
            <TextBlock
                Margin="8,0,0,0"
                FontSize="10"
                FontWeight="Bold"
                Foreground="Gray"
                Text="{Binding TraceShort}" />
        </StackPanel>
    </DataTemplate>

    <!--  Сообщение с трассировкой и указанием модуля  -->
    <DataTemplate x:Key="LotusLogTraceModuleMessageKey">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Image
                    Height="24"
                    Margin="2,0"
                    VerticalAlignment="Center"
                    Source="{Binding Path=Type, Converter={StaticResource LotusLogTypeToImageConverterKey}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="{Binding Path=Module, StringFormat='[\{0\}]'}" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Text="{Binding Path=Text}" />
            </StackPanel>
            <TextBlock
                Margin="8,0,0,0"
                FontSize="10"
                FontWeight="Bold"
                Foreground="Gray"
                Text="{Binding TraceShort}" />
        </StackPanel>
    </DataTemplate>

    <!--  Селектор шаблона для списка лога  -->
    <ctrl:LogViewItemDataSelector
        x:Key="LotusLogDataSelectorKey"
        Simple="{StaticResource LotusLogSimpleMessageKey}"
        SimpleModule="{StaticResource LotusLogSimpleModuleMessageKey}"
        Trace="{StaticResource LotusLogTraceMessageKey}"
        TraceModule="{StaticResource LotusLogTraceModuleMessageKey}" />

    <!--  Панель лога  -->
    <Style
        BasedOn="{StaticResource {x:Type UserControl}}"
        TargetType="{x:Type ctrl:LotusLoggerControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:LotusLoggerControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal">
                            <Button
                                x:Name="buttonClear"
                                Height="24"
                                Margin="2"
                                Content="Очистить" />
                            <Button
                                x:Name="buttonSave"
                                Height="24"
                                Margin="2"
                                Content="Сохранить" />
                        </StackPanel>
                        <ListBox
                            x:Name="outputData"
                            Grid.Row="1"
                            Margin="2,0,2,2"
                            ItemTemplateSelector="{StaticResource LotusLogDataSelectorKey}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
