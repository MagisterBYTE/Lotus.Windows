<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Lotus.Windows"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/LotusResourceStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Размер иконки элемента меню  -->
    <sys:Double x:Key="LotusMenuItemIconSize">16</sys:Double>

    <!--  Элемент меню с иконкой и текстом из связанной команды  -->
    <Style
        BasedOn="{StaticResource {x:Type MenuItem}}"
        TargetType="{x:Type ctrl:LotusMenuItemIcon}">
        <Setter Property="Header" Value="{Binding Path=Command.Text, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{StaticResource LotusFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LotusFontSize}" />
    </Style>

</ResourceDictionary>
