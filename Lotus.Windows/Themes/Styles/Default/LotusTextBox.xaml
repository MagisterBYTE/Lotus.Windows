<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/LotusResourceStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Стандартное текстовое поле Lotus  -->
    <Style
        x:Key="LotusTextBoxStyleKey"
        TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource LotusFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LotusFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource LotusForegroundBrush}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource LotusBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="SelectionBrush" Value="{StaticResource LotusAccentBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource LotusAccentBrush}" />
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource LotusAccentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="SnapsToDevicePixels" Value="true" />
                <Setter Property="UseLayoutRounding" Value="true" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
