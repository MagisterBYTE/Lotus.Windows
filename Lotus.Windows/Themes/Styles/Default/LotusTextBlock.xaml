<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/LotusResourceStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Заголовочный текст  -->
    <Style
        x:Key="LotusTextBlockHeaderStyleKey"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LotusFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LotusFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Текст статуса  -->
    <Style
        x:Key="LotusTextBlockStatusStyleKey"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LotusFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LotusFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Текст параметра  -->
    <Style
        x:Key="LotusTextBlockParameterStyleKey"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LotusFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource LotusFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Текст финансового значения (специализированный шрифт для числовых данных)  -->
    <Style
        x:Key="LotusTextBlockFinanceValueStyleKey"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Arial Narrow" />
        <Setter Property="FontSize" Value="{StaticResource LotusFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource LotusAccentBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0,2,0" />
    </Style>

</ResourceDictionary>
