<Window
    x:Class="Lotus.Windows.LotusGrowlNotification"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="300"
    Height="530"
    d:DesignHeight="300"
    d:DesignWidth="300"
    AllowsTransparency="True"
    Background="Transparent"
    ShowActivated="False"
    ShowInTaskbar="False"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/LotusGrowlNotification.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Шаблон отображения уведомления. Остаётся здесь, так как ссылается на обработчик SizeChanged из code-behind.  -->
            <DataTemplate x:Key="MessageTemplate">
                <Grid
                    x:Name="NotificationWindow"
                    Background="Transparent"
                    SizeChanged="NotificationWindow_SizeChanged"
                    Tag="{Binding Path=ID}">
                    <Border
                        Name="border"
                        Margin="5"
                        Background="#2a3345"
                        BorderThickness="0"
                        CornerRadius="5">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="10"
                                Opacity="0.8"
                                ShadowDepth="0" />
                        </Border.Effect>
                        <Grid
                            Width="280"
                            Height="100"
                            Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="32"
                                Margin="4"
                                Source="{Binding Path=NoticeType, Converter={StaticResource LotusNotificationTypeToImageConverterKey}}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="2,4,4,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Arial"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Path=Title}"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextRenderingMode="ClearType"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="CloseButton"
                                Grid.Row="0"
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                Margin="0,0,12,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource LotusGrowlCloseButtonStyleKey}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Margin="2,2,4,4"
                                VerticalAlignment="Center"
                                FontFamily="Arial"
                                Foreground="White"
                                Text="{Binding Path=Message}"
                                TextOptions.TextFormattingMode="Display"
                                TextOptions.TextRenderingMode="ClearType"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <EventTrigger
                        RoutedEvent="FrameworkElement.Loaded"
                        SourceName="NotificationWindow">
                        <BeginStoryboard x:Name="FadeInStoryBoard">
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="NotificationWindow"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0.01"
                                    To="1"
                                    Duration="0:0:1" />
                                <DoubleAnimation
                                    BeginTime="0:0:4"
                                    Storyboard.TargetName="NotificationWindow"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <SeekStoryboard
                                BeginStoryboardName="FadeInStoryBoard"
                                Offset="0:0:2" />
                            <PauseStoryboard BeginStoryboardName="FadeInStoryBoard" />
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <SeekStoryboard
                                BeginStoryboardName="FadeInStoryBoard"
                                Offset="0:0:2" />
                            <ResumeStoryboard BeginStoryboardName="FadeInStoryBoard" />
                        </Trigger.ExitActions>
                    </Trigger>
                    <EventTrigger
                        RoutedEvent="Button.Click"
                        SourceName="CloseButton">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="NotificationWindow"
                                    Storyboard.TargetProperty="(Grid.Opacity)"
                                    From="1"
                                    To="0"
                                    Duration="0:0:0" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <Trigger SourceName="NotificationWindow" Property="Opacity" Value="0">
                        <Setter TargetName="NotificationWindow" Property="Visibility" Value="Hidden" />
                        <Trigger.EnterActions>
                            <BeginStoryboard Storyboard="{StaticResource LotusGrowlCollapseStoryboardKey}" />
                        </Trigger.EnterActions>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <ItemsControl
        x:Name="NotificationsControl"
        FocusVisualStyle="{x:Null}"
        ItemTemplate="{StaticResource MessageTemplate}"
        ItemsSource="{Binding .}" />
</Window>
