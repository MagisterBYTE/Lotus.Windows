<Window
    x:Class="Lotus.Windows.LotusWindowLongTaskInformer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Идет процесс"
    Width="240"
    Height="80"
    Topmost="True"
    mc:Ignorable="d">
    <StackPanel
        VerticalAlignment="Center"
        Orientation="Vertical">
        <ProgressBar
            Width="160"
            Height="20"
            VerticalAlignment="Center"
            Value="{Binding ProgressValue, RelativeSource={RelativeSource AncestorType=Window}}" />
        <TextBlock
            Width="200"
            Margin="4"
            HorizontalAlignment="Left"
            Text="{Binding InformerText, RelativeSource={RelativeSource AncestorType=Window}}" />
    </StackPanel>
</Window>
