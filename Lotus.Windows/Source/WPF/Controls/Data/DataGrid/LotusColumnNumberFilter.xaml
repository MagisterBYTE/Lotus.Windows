<UserControl
    x:Class="Lotus.Windows.LotusColumnNumberFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Lotus.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    d:DesignHeight="80"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/LotusResourceStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/Default/LotusComboBox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/Default/LotusToggleButton.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/ValueConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Vertical">
        <!--  Левое значение (основное)  -->
        <ctrl:LotusTextBox
            Height="24"
            Margin="2,2,2,1"
            VerticalContentAlignment="Center"
            IsEnabled="{Binding ElementName=root, Path=QueryItem.NotCalculation, Converter={StaticResource BooleanInverseConverterKey}}"
            ShowButtonClear="True"
            Text="{Binding ElementName=root, Path=QueryItem.ComparisonValueLeft, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DoubleToStringConverterKey}}" />
        <!--  Правое значение (только для Between)  -->
        <ctrl:LotusTextBox
            Height="24"
            Margin="2,0,2,1"
            VerticalContentAlignment="Center"
            IsEnabled="{Binding ElementName=root, Path=QueryItem.NotCalculation, Converter={StaticResource BooleanInverseConverterKey}}"
            ShowButtonClear="True"
            Text="{Binding ElementName=root, Path=QueryItem.ComparisonValueRight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Converter={StaticResource DoubleToStringConverterKey}}">
            <ctrl:LotusTextBox.Style>
                <Style TargetType="{x:Type ctrl:LotusTextBox}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding ElementName=root, Path=QueryItem.FilterFunction}"
                            Value="{x:Static ctrl:TFilterFunction.Between}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ctrl:LotusTextBox.Style>
        </ctrl:LotusTextBox>
        <!--  Оператор и кнопка выключения  -->
        <DockPanel Margin="2,1,2,2">
            <ToggleButton
                Width="24"
                Content="A"
                DockPanel.Dock="Right"
                IsChecked="{Binding ElementName=root, Path=QueryItem.NotCalculation, Mode=TwoWay, Converter={StaticResource BooleanInverseConverterKey}}"
                Style="{StaticResource LotusToggleButtonStyleKey}" />
            <ComboBox
                IsEnabled="{Binding ElementName=root, Path=QueryItem.NotCalculation, Converter={StaticResource BooleanInverseConverterKey}}"
                ItemsSource="{Binding ElementName=root, Path=QueryItem.FilterFunctions}"
                SelectedItem="{Binding ElementName=root, Path=QueryItem.FilterFunction, Mode=TwoWay}"
                Style="{StaticResource LotusComboBoxStyleKey}" />
        </DockPanel>
    </StackPanel>
</UserControl>
