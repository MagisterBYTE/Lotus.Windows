<UserControl
    x:Class="Lotus.Windows.LotusMeasurementEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Lotus.Core;assembly=Lotus.Core"
    xmlns:ctrl="clr-namespace:Lotus.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:unit="clr-namespace:Lotus.UnitMeasurement;assembly=Lotus.UnitMeasurement"
    d:DesignHeight="34"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/LotusResourceStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/Default/LotusButton.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/ValueConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Строковые ресурсы групп единиц измерения  -->
            <sys:String x:Key="LotusMeasurementGroupThingKey">Объект</sys:String>
            <sys:String x:Key="LotusMeasurementGroupLengthKey">Длина</sys:String>
            <sys:String x:Key="LotusMeasurementGroupAreaKey">Площадь</sys:String>

            <!--  Строковые ресурсы единиц измерения  -->
            <sys:String x:Key="LotusMeasurementUnitThingKey">шт</sys:String>
            <sys:String x:Key="LotusMeasurementUnitKitKey">комп.</sys:String>
            <sys:String x:Key="LotusMeasurementUnitMeterKey">м</sys:String>
            <sys:String x:Key="LotusMeasurementUnitKilometerKey">км</sys:String>
            <sys:String x:Key="LotusMeasurementUnitSquareMeterKey">м²</sys:String>
            <sys:String x:Key="LotusMeasurementUnitSquareKilometerKey">км²</sys:String>

            <!--  Строковые ресурсы пунктов меню  -->
            <sys:String x:Key="LotusMeasurementCopyKey">Копировать</sys:String>
            <sys:String x:Key="LotusMeasurementPasteKey">Вставить</sys:String>
            <sys:String x:Key="LotusMeasurementClearKey">Очистка</sys:String>
            <sys:String x:Key="LotusMeasurementDefaultKey">Значение по умолчанию</sys:String>
            <sys:String x:Key="LotusMeasurementRadix0Key">Разрядность 0</sys:String>
            <sys:String x:Key="LotusMeasurementRadix1Key">Разрядность 0,0</sys:String>
            <sys:String x:Key="LotusMeasurementRadix2Key">Разрядность 0,00</sys:String>
            <sys:String x:Key="LotusMeasurementRadix3Key">Разрядность 0,000</sys:String>

            <!--  Иконки пунктов меню  -->
            <BitmapImage
                x:Key="LotusMeasurementIconCopyKey"
                UriSource="/Lotus.Windows;component/Resources/Icons/Edit/Oxygen_edit_copy_32.png" />
            <BitmapImage
                x:Key="LotusMeasurementIconPasteKey"
                UriSource="/Lotus.Windows;component/Resources/Icons/Edit/Oxygen_edit_paste_32.png" />
            <BitmapImage
                x:Key="LotusMeasurementIconDeleteKey"
                UriSource="/Lotus.Windows;component/Resources/Icons/Edit/Oxygen_edit_delete_32.png" />
            <BitmapImage
                x:Key="LotusMeasurementIconRefreshKey"
                UriSource="/Lotus.Windows;component/Resources/Icons/View/Oxygen_view_refresh_32.png" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ctrl:LotusStackPanel>

        <!--  Текстовое поле ввода  -->
        <TextBox
            x:Name="TextField"
            VerticalContentAlignment="Center"
            ctrl:LotusStackPanel.Fill="Fill"
            IsReadOnly="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:LotusMeasurementEditor}, Path=IsReadOnly}"
            KeyDown="OnTextField_KeyDown"
            LostFocus="OnTextField_LostFocus">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:LotusMeasurementEditor}, Path=IsReadOnly}"
                            Value="True">
                            <Setter Property="Background" Value="{StaticResource LotusAccentLightBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <!--  Кнопки увеличения/уменьшения (скрыты в режиме только для чтения)  -->
        <ctrl:LotusStackPanel
            Orientation="Vertical"
            Visibility="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:LotusMeasurementEditor}, Path=IsReadOnly, Converter={StaticResource BooleanTrueToCollapsedConverterKey}}">
            <RepeatButton
                x:Name="ButtonUp"
                MinWidth="16"
                Padding="0"
                Click="OnButtonUp_Click"
                Style="{StaticResource LotusRepeatButtonStyleKey}">
                <RepeatButton.Content>
                    <TextBlock
                        FontSize="10"
                        Text="{x:Static core:XStringHelper.TriangleUp}" />
                </RepeatButton.Content>
            </RepeatButton>
            <RepeatButton
                x:Name="ButtonDown"
                MinWidth="16"
                Padding="0"
                Click="OnButtonDown_Click"
                Style="{StaticResource LotusRepeatButtonStyleKey}">
                <RepeatButton.Content>
                    <TextBlock
                        FontSize="10"
                        Text="{x:Static core:XStringHelper.TriangleDown}" />
                </RepeatButton.Content>
            </RepeatButton>
        </ctrl:LotusStackPanel>

        <!--  Кнопка открытия меню. Tag передаёт IsReadOnly в ContextMenu через PlacementTarget  -->
        <Button
            x:Name="ButtonMenu"
            Click="OnButtonMenu_Click"
            Style="{StaticResource LotusButtonStyleKey}"
            Tag="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:LotusMeasurementEditor}, Path=IsReadOnly}">
            <Button.ContextMenu>
                <ContextMenu>

                    <!--  Объект  -->
                    <MenuItem Header="{StaticResource LotusMeasurementGroupThingKey}">
                        <MenuItem
                            Click="OnMenuItemSetUnit_Click"
                            Header="{StaticResource LotusMeasurementUnitThingKey}"
                            Tag="{x:Static unit:TUnitThing.Thing}" />
                        <MenuItem
                            Click="OnMenuItemSetUnit_Click"
                            Header="{StaticResource LotusMeasurementUnitKitKey}"
                            Tag="{x:Static unit:TUnitThing.Kit}" />
                    </MenuItem>

                    <!--  Длина  -->
                    <MenuItem Header="{StaticResource LotusMeasurementGroupLengthKey}">
                        <MenuItem
                            Click="OnMenuItemSetUnit_Click"
                            Header="{StaticResource LotusMeasurementUnitMeterKey}"
                            Tag="{x:Static unit:TUnitLength.Meter}" />
                        <MenuItem
                            Click="OnMenuItemSetUnit_Click"
                            Header="{StaticResource LotusMeasurementUnitKilometerKey}"
                            Tag="{x:Static unit:TUnitLength.Kilometer}" />
                    </MenuItem>

                    <!--  Площадь  -->
                    <MenuItem Header="{StaticResource LotusMeasurementGroupAreaKey}">
                        <MenuItem
                            Click="OnMenuItemSetUnit_Click"
                            Header="{StaticResource LotusMeasurementUnitSquareMeterKey}"
                            Tag="{x:Static unit:TUnitArea.SquareMeter}" />
                        <MenuItem
                            Click="OnMenuItemSetUnit_Click"
                            Header="{StaticResource LotusMeasurementUnitSquareKilometerKey}"
                            Tag="{x:Static unit:TUnitArea.SquareKilometer}" />
                    </MenuItem>

                    <Separator />

                    <!--  Копировать (всегда доступно)  -->
                    <MenuItem
                        Click="OnMenuItemCopyValue_Click"
                        Header="{StaticResource LotusMeasurementCopyKey}">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource LotusMeasurementIconCopyKey}"
                                Stretch="Fill" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <!--  Вставить (недоступно в режиме только для чтения)  -->
                    <MenuItem
                        Click="OnMenuItemPasteValue_Click"
                        Header="{StaticResource LotusMeasurementPasteKey}">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource LotusMeasurementIconPasteKey}"
                                Stretch="Fill" />
                        </MenuItem.Icon>
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>

                    <!--  Очистка (недоступно в режиме только для чтения)  -->
                    <MenuItem
                        Click="OnMenuItemClearValue_Click"
                        Header="{StaticResource LotusMeasurementClearKey}">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource LotusMeasurementIconDeleteKey}"
                                Stretch="Fill" />
                        </MenuItem.Icon>
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>

                    <Separator />

                    <!--  Значение по умолчанию (недоступно в режиме только для чтения)  -->
                    <MenuItem
                        Click="OnMenuItemSetDefaultValue_Click"
                        Header="{StaticResource LotusMeasurementDefaultKey}">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource LotusMeasurementIconRefreshKey}"
                                Stretch="Fill" />
                        </MenuItem.Icon>
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>

                    <Separator />

                    <!--  Выбор разрядности. Tag содержит строку формата.  -->
                    <RadioButton
                        Checked="OnRadioRadix_Checked"
                        Content="{StaticResource LotusMeasurementRadix0Key}"
                        Tag="{}{0}" />
                    <RadioButton
                        Checked="OnRadioRadix_Checked"
                        Content="{StaticResource LotusMeasurementRadix1Key}"
                        Tag="{}{0:F1}" />
                    <RadioButton
                        Checked="OnRadioRadix_Checked"
                        Content="{StaticResource LotusMeasurementRadix2Key}"
                        Tag="{}{0:F2}" />
                    <RadioButton
                        Checked="OnRadioRadix_Checked"
                        Content="{StaticResource LotusMeasurementRadix3Key}"
                        Tag="{}{0:F3}" />

                </ContextMenu>
            </Button.ContextMenu>
        </Button>

    </ctrl:LotusStackPanel>
</UserControl>
