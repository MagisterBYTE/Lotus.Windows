<UserControl
    x:Class="Lotus.Windows.LotusNumericEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Lotus.Core;assembly=Lotus.Core"
    xmlns:ctrl="clr-namespace:Lotus.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    x:Name="numericEditor"
    d:DesignHeight="30"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/LotusResourceStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/Styles/Default/LotusButton.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Lotus.Windows;component/Themes/ValueConverters.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Строковые ресурсы пунктов меню  -->
            <sys:String x:Key="LotusNumericCopyKey">Копировать</sys:String>
            <sys:String x:Key="LotusNumericPasteKey">Вставить</sys:String>
            <sys:String x:Key="LotusNumericClearKey">Очистка</sys:String>
            <sys:String x:Key="LotusNumericDefaultKey">Значение по умолчанию</sys:String>
            <sys:String x:Key="LotusNumericRadix0Key">Разрядность 0</sys:String>
            <sys:String x:Key="LotusNumericRadix1Key">Разрядность 0,0</sys:String>
            <sys:String x:Key="LotusNumericRadix2Key">Разрядность 0,00</sys:String>
            <sys:String x:Key="LotusNumericRadix3Key">Разрядность 0,000</sys:String>

            <!--  Иконки пунктов меню  -->
            <BitmapImage
                x:Key="LotusIconCopyKey"
                UriSource="/Lotus.Windows;component/Resources/Icons/Edit/Oxygen_edit_copy_32.png" />
            <BitmapImage
                x:Key="LotusIconPasteKey"
                UriSource="/Lotus.Windows;component/Resources/Icons/Edit/Oxygen_edit_paste_32.png" />
            <BitmapImage
                x:Key="LotusIconDeleteKey"
                UriSource="/Lotus.Windows;component/Resources/Icons/Edit/Oxygen_edit_delete_32.png" />
            <BitmapImage
                x:Key="LotusIconRefreshKey"
                UriSource="/Lotus.Windows;component/Resources/Icons/View/Oxygen_view_refresh_32.png" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ctrl:LotusStackPanel>

        <!--  Текстовое поле ввода  -->
        <TextBox
            x:Name="TextField"
            VerticalContentAlignment="Center"
            ctrl:LotusStackPanel.Fill="Fill"
            IsReadOnly="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:LotusNumericEditor}, Path=IsReadOnly}"
            KeyDown="OnTextField_KeyDown"
            LostFocus="OnTextField_LostFocus">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:LotusNumericEditor}, Path=IsReadOnly}"
                            Value="True">
                            <Setter Property="Background" Value="{StaticResource LotusAccentLightBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <!--  Кнопки увеличения/уменьшения (скрыты в режиме только для чтения)  -->
        <ctrl:LotusStackPanel
            Orientation="Vertical"
            Visibility="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:LotusNumericEditor}, Path=IsReadOnly, Converter={StaticResource BooleanTrueToCollapsedConverterKey}}">
            <RepeatButton
                x:Name="ButtonUp"
                MinWidth="16"
                Padding="0"
                Click="OnButtonUp_Click"
                Style="{StaticResource LotusRepeatButtonStyleKey}">
                <RepeatButton.Content>
                    <TextBlock
                        FontSize="10"
                        Text="{x:Static core:XStringHelper.TriangleUp}" />
                </RepeatButton.Content>
            </RepeatButton>
            <RepeatButton
                x:Name="ButtonDown"
                MinWidth="16"
                Padding="0"
                Click="OnButtonDown_Click"
                Style="{StaticResource LotusRepeatButtonStyleKey}">
                <RepeatButton.Content>
                    <TextBlock
                        FontSize="10"
                        Text="{x:Static core:XStringHelper.TriangleDown}" />
                </RepeatButton.Content>
            </RepeatButton>
        </ctrl:LotusStackPanel>

        <!--  Кнопка открытия меню. Tag передаёт IsReadOnly в ContextMenu через PlacementTarget  -->
        <Button
            x:Name="ButtonMenu"
            Click="OnButtonMenu_Click"
            Content="{x:Static core:XStringHelper.TriangleDown}"
            Style="{StaticResource LotusButtonStyleKey}"
            Tag="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ctrl:LotusNumericEditor}, Path=IsReadOnly}">
            <Button.ContextMenu>
                <ContextMenu>

                    <!--  Копировать (всегда доступно)  -->
                    <MenuItem
                        Click="OnMenuItemCopyValue_Click"
                        Header="{StaticResource LotusNumericCopyKey}">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource LotusIconCopyKey}"
                                Stretch="Fill" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <!--  Вставить (недоступно в режиме только для чтения)  -->
                    <MenuItem
                        Click="OnMenuItemPasteValue_Click"
                        Header="{StaticResource LotusNumericPasteKey}">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource LotusIconPasteKey}"
                                Stretch="Fill" />
                        </MenuItem.Icon>
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>

                    <!--  Очистка (недоступно в режиме только для чтения)  -->
                    <MenuItem
                        Click="OnMenuItemClearValue_Click"
                        Header="{StaticResource LotusNumericClearKey}">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource LotusIconDeleteKey}"
                                Stretch="Fill" />
                        </MenuItem.Icon>
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>

                    <Separator />

                    <!--  Значение по умолчанию (недоступно в режиме только для чтения)  -->
                    <MenuItem
                        Click="OnMenuItemSetDefaultValue_Click"
                        Header="{StaticResource LotusNumericDefaultKey}">
                        <MenuItem.Icon>
                            <Image
                                Width="16"
                                Height="16"
                                Source="{StaticResource LotusIconRefreshKey}"
                                Stretch="Fill" />
                        </MenuItem.Icon>
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>

                    <Separator />

                    <!--  Выбор разрядности. Tag содержит строку формата.  -->
                    <RadioButton
                        Checked="OnRadioRadix_Checked"
                        Content="{StaticResource LotusNumericRadix0Key}"
                        Tag="{}{0}" />
                    <RadioButton
                        Checked="OnRadioRadix_Checked"
                        Content="{StaticResource LotusNumericRadix1Key}"
                        Tag="{}{0:F1}" />
                    <RadioButton
                        Checked="OnRadioRadix_Checked"
                        Content="{StaticResource LotusNumericRadix2Key}"
                        Tag="{}{0:F2}" />
                    <RadioButton
                        Checked="OnRadioRadix_Checked"
                        Content="{StaticResource LotusNumericRadix3Key}"
                        Tag="{}{0:F3}" />

                </ContextMenu>
            </Button.ContextMenu>
        </Button>

    </ctrl:LotusStackPanel>
</UserControl>
